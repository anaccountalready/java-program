package big.work.cn;

public class User {
int id;
String name;
int money;
CDbook tools=new CDbook();
public User(int id, String name, int money, CDbook tools) {
	super();
	this.id = id;
	this.name = name;
	this.money = money;
	this.tools = tools;
}
public User(int id, String name, int money) {
	// TODO Auto-generated constructor stub
	super();
	this.id = id;
	this.name = name;
	this.money = money;
	this.tools.data=null;
}
@Override
public String toString() {
	if(this!=null&&this.tools!=null)return "User [id=" + id + ", name=" + name + ", money=" + money
			+ tools+"]";
	else if(this!=null&&this.tools==null)return  "User [id=" + id + ", name=" + name + ", money=" + money
			+ "没有借还记录"+"]";
	else return"没有id为"+id+"的用户";
}

}
