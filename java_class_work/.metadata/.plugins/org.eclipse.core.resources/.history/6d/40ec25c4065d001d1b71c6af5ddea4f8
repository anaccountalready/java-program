package big.work.cn;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
/**
 * 用户管理usersmanage()实现显示当前所有用户信息和一次删除（会提示删除的用户是否存在，数量是否正确【不正确则返回上级菜单】）和添加多个用户的功能还有根据用户id查找的功能
 * */
public class Boss {
Userbook userbook=new Userbook();
CDbook cdbook=new CDbook();
BufferedReader in=new BufferedReader(new InputStreamReader(System.in));
public static void main(String[] args) throws IOException {
	new Boss().begin();
}
public void begin() throws IOException{
	while(true){
		 printMainMenu();
		 String line=in.readLine();
		 int chioce=Integer.parseInt(line);
		 switch(chioce){
		 case 1:
			 usersmanage();
			 break;
		 case 2:
			 cdmanage();
			 break;
		 case 3:return;
		 }
	}
}
private void cdmanage() throws IOException {
	// TODO Auto-generated method stub
	while(true){
		 printCDMenu();
		 String line=in.readLine();
		 int chioce=Integer.parseInt(line);
		 switch(chioce){
		 case 1:
			cdbook.list();
			 break;
		 case 2:
			 System.out.println("请输入借CD的用户的个数");
			 String c1=in.readLine();
			 int pn=Integer.parseInt(c1);
			 while(pn--!=0){
			 System.out.println("请依次输入需要借CD的用户id和借CD的种类数和借每种CD的id+数量:(以空格分割)");
			 String l1=in.readLine();
			 String []l2=new String[1000];
			 l2=l1.split(" ");
			 if(userbook.finduser(Integer.parseInt(l2[0]))==null){System.out.println("该用户未被收录，请返回用户管理添加该用户后再执行该操作");break;}
			 else {
				 int lentks=Integer.parseInt(l2[1]);//借CD的种类数
					 for(int x1=2,x2=3;lentks!=0;x1+=2,x2+=2)
					 { Disk disk=new Disk(Integer.parseInt(l2[x1]),Integer.parseInt(l2[x2]));
						if( cdbook.find(disk.id)!=null){
							cdbook.remove(disk);
							userbook.finduser(Integer.parseInt(l2[0])).tools.addCD(disk);
						}
						else cdbook.remove(disk);
						lentks--;
					 }
				} }
			 break;
		 case 3:
			 System.out.println("请输入归还CD的用户的个数");
			 String c2=in.readLine();
			 int pen=Integer.parseInt(c2);
			 while(pen--!=0){
			 System.out.println("请依次输入需要归还CD的用户id和借归还CD的种类数和归还每种CD的id+数量:(以空格分割)");
			 String l1=in.readLine();
			 String []l2=new String[1000];
			 l2=l1.split(" ");
			 if(userbook.finduser(Integer.parseInt(l2[0]))==null){System.out.println("记录可能出错，该用户未被收录，请仔细确认当初是否添加该用户，如需要添加则请返回用户管理添加该用户后再执行该操作");break;}
			 else {
				 int lentks=Integer.parseInt(l2[1]);//归还CD的种类数
					 for(int x1=2,x2=3;lentks!=0;x1+=2,x2+=2)
					 { Disk disk=new Disk(Integer.parseInt(l2[x1]),Integer.parseInt(l2[x2]));
						   cdbook.addCD(disk);
							userbook.finduser(Integer.parseInt(l2[0])).tools.userremove(disk);
					        lentks--;
					 }
				} }
			 break;
		 case 4:
			 //5 0 12 13 1 23 22 2 33 23 4 21 2 5 12 56
			 System.out.println("请输入需要添加新CD的种类数和每一种CD的id和价格和数量:用空格分割");
			 String l5=in.readLine();
			 String []l6=new String[1000];
			 l6=l5.split(" ");
			 int adnum=Integer.parseInt(l6[0]);
			 for(int i=1,j=2,k=3;adnum>0;i+=3,j+=3,k+=3){
				 int cdid=Integer.parseInt(l6[i]);
				 double cdprice=Integer.parseInt(l6[j]);
				 int cdnum=Integer.parseInt(l6[k]);
				 Disk disk=new Disk(cdid,cdprice,cdnum);
				 cdbook.addCD(disk);
				 adnum--;
			 }
				 
			 
			 break;
		 case 5:System.out.println("请输入查找CD的id");
		 String l4=in.readLine();
		if(cdbook.find(Integer.parseInt(l4))!=null) {System.out.println(cdbook.find(Integer.parseInt(l4)));}
		break;
		 case 6:return;
		 }
	}
}

private void usersmanage() throws IOException {
	// TODO Auto-generated method stub
	while(true){
		 printusersMenu();
		 String line=in.readLine();
		 int chioce=Integer.parseInt(line);
		 switch(chioce){
		 case 1:
			 userbook.list();
			 break;
		 case 2:
			 System.out.println("请依次输入需要输入要删除用户的数量和其id:（以空格分割）");
			 String l=in.readLine();
			 String []c=new String[1000];
			 c=l.split(" ");
			 int movenum=Integer.parseInt(c[0]);
			 if(movenum>userbook.usernum){System.out.println("输入有误，当前用户总数为:"+userbook.usernum+";将返回上级菜单");break;}
			 else{
				 for(int y=1;movenum>0;y++){
				if(userbook.finduser(Integer.parseInt(c[y]))!=null)
				{userbook.removeuser(userbook.finduser(Integer.parseInt(c[y])));movenum--;}
				else movenum--;
				
			}}
			 break;
		 case 3:
			 //4 0 x1 12 1 x2 13 2 x3 14 3 x4 15
		     System.out.println("请依次输入需要添加用户的数量以及每一位用户的id 名字 充值余额:（以空格分割）");
			 String str=in.readLine();
			 String [] as=new String[1000];
			 as=str.split(" ");
			 int addsum=Integer.parseInt(as[0]);
			 for(int y=1,z=2,w=3;addsum>0;y+=3,z+=3,w+=3){
			 User newuser=new User(Integer.parseInt(as[y]),as[z],Integer.parseInt(as[w]));
			 userbook.adduser(newuser);
			 addsum--;
			 }
			 break;
		case 4:
			 System.out.println("请输入要查找用户的id:");
			 String x=in.readLine();
			 int j=Integer.parseInt(x);
			if(userbook.finduser(j)!=null) System.out.println(userbook.finduser(j));
			 break;
		 case 5:return;
		 }
	}
}
