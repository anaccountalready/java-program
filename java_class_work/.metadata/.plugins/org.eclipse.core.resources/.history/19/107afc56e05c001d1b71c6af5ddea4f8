package big.work.cn;

public class CDbook {
Disk []data=new Disk[1000];
public void addCD(Disk cd) {
	if(data[cd.id]==null)data[cd.id]=cd;
	else {data[cd.id].num+=cd.num;}
}
public void remove(Disk cd){
	if(data[cd.id]==null){
		System.out.println("库中没有该CD");
		System.out.println("是否进货该CD");
		}
	else if(data[cd.id].num>=cd.num){data[cd.id].num-=cd.num;}
	else {
		System.out.println("库中有该光盘数量为"+data[cd.id].num+"不够借出");
		System.out.println("是否进货该CD");
		}
}
public Disk find(int id){
	if(data[id]==null){System.out.println("库中没有该光盘");return null;}
	else return data[id];
}
public void list(){
	for(Disk m:data){
		System.out.println(m);
	}
}
}
