package big.work.cn;

import java.util.Arrays;

public class CDbook {
Disk []data=new Disk[1000];

@Override
public String toString() {
	if(this.data!=null){return "CDbook [data=" + Arrays.toString(data) + "]";} 
	else
		return "CDbook [data=" +0+ "this user hasn't borrowed]";
}
public void addCD(Disk cd) {
	if(data[cd.id]==null)data[cd.id]=cd;
	else {data[cd.id].num+=cd.num;}
}
public void remove(Disk cd){
	if(data[cd.id]==null){
		System.out.println("库中没有id为"+cd.id+"的CD");
		System.out.println("将进货id为"+cd.id+"的CD"+cd.num+"个");
		addCD(cd);
		}
	else if(data[cd.id].num>=cd.num){data[cd.id].num-=cd.num;}
	else {
		System.out.println("库中有该光盘数量为"+data[cd.id].num+"不够借出,将所有该CD全部借出");
		data[cd.id].num=0;
		System.out.println("将进货id为"+cd.id+"的CD"+cd.num+"个");
		addCD(cd);
		}
}
public Disk find(int id){
	if(data[id]==null){System.out.println("库中没有id为"+id+"的CD");return null;}
	else return data[id];
}
public void list(){
	for(Disk m:data){
		if(m!=null)System.out.println(m);
	}
}
}
