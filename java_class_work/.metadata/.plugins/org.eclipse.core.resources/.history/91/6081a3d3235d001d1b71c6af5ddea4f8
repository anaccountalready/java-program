	System.out.println("1:显示当前所有种类CD");
	System.out.println("2:借出CD");
	System.out.println("3:归还CD");
	System.out.println("4:添加新CD");
	System.out.println("5:查找所需CD");
	System.out.println("6:退出CD菜单");
