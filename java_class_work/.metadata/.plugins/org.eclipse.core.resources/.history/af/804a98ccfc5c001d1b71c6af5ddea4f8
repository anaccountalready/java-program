package big.work.cn;

public class Disk {
int id;
double price;
int num;
public Disk(int id, double price, int num) {
	super();
	
	this.id = id;
	this.price = price;
	this.num = num;
}
public Disk(int id,int num) {
	// TODO Auto-generated constructor stub
	this.id=id;
	this.num=num;
}
@Override
public String toString() {
	return "Disk [id=" + id + ", price=" + price + ", num="
			+ num + "]";
}

}

