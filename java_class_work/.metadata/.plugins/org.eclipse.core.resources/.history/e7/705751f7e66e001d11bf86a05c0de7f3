package cn.edu.nankai.cn;
import java.io.File;
import java.util.Scanner;
class Sum{
	static int filenum=0;//总文件夹数
	static double sumsize=0; //文件尺寸总和
	static int lfnum=0;//文件数总和
	void sum(File f){
		   if(f.isFile()){
				filenum++;
				sumsize+=f.length();
			}
			else if(f.isDirectory()){
				System.out.println(f.getName());
				lfnum++;
				File[]l=f.listFiles();
				for(File m:l){
				 sum(m);
				}		
			}
		}
}
