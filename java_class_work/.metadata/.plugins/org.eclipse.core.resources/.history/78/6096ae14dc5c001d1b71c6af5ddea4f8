package big.work.cn;

public class User {
int id;
String name;
double money;
CDbook tools=new CDbook();
public User(int id, String name, double money, CDbook tools) {
	super();
	this.id = id;
	this.name = name;
	this.money = money;
	this.tools = tools;
}
@Override
public String toString() {
	return "User [id=" + id + ", name=" + name + ", money=" + money
			+ ", tools=" + tools + "]";
}

}
